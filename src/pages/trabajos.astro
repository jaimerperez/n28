---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

// Los vídeos NO se versionan: GitHub Pages limita a 1 GB por repositorio.
// Cada trabajo referencia un id de Vimeo y se incrusta bajo demanda.
// TODO(n28): sustituir por los trabajos reales del estudio.
const trabajos: { titulo: string; interprete: string; vimeoId: string }[] = [];
---

<Layout
  title="Trabajos"
  description="Selección de videobooks y piezas audiovisuales producidas en n28."
>
  <PageHeader
    eyebrow="Portfolio"
    title="Trabajos"
    lead="Una muestra de los videobooks y piezas que hemos producido."
  />

  <section class="mx-auto max-w-6xl px-6 pb-12">
    {
      trabajos.length === 0 ? (
        <p class="text-bone/60 rounded-lg border border-dashed border-white/15 p-10 text-center">
          Estamos preparando esta sección.
        </p>
      ) : (
        <ul class="grid gap-8 md:grid-cols-2">
          {trabajos.map((trabajo) => (
            <li>
              <div class="aspect-video overflow-hidden rounded-lg bg-white/5">
                <iframe
                  src={`https://player.vimeo.com/video/${trabajo.vimeoId}?dnt=1`}
                  title={`${trabajo.titulo} — ${trabajo.interprete}`}
                  class="h-full w-full"
                  loading="lazy"
                  allow="fullscreen; picture-in-picture"
                  allowfullscreen
                />
              </div>
              <h2 class="mt-3 text-lg">{trabajo.titulo}</h2>
              <p class="text-bone/60 text-sm">{trabajo.interprete}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
