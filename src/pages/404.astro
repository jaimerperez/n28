---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---

<Layout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="mx-auto max-w-6xl px-6 py-24 text-center md:py-32">
    <p class="text-accent font-display text-6xl">404</p>
    <h1 class="mt-4 text-2xl">Esta página no existe</h1>
    <p class="text-bone/70 mt-4">Puede que el enlace esté roto o que la hayamos movido.</p>
    <a href={url('/')} class="text-accent mt-8 inline-block underline underline-offset-4">
      Volver al inicio
    </a>
  </section>
</Layout>
