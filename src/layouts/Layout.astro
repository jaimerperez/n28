---
import '../styles/global.css';
import { siteConfig, nav } from '../config/site';
import { url, isCurrent } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title
  ? `${title} · ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="bg-ink text-bone flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="focus:bg-accent focus:text-ink sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:px-4 focus:py-2"
    >
      Saltar al contenido
    </a>

    <header class="border-b border-white/10">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
        aria-label="Principal"
      >
        <a href={url('/')} class="font-display text-xl tracking-tight">
          {siteConfig.name}
        </a>
        <ul class="hidden gap-8 text-sm md:flex">
          {
            nav.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  class="hover:text-accent transition-colors"
                  aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-white/10">
      <div
        class="text-bone/60 mx-auto flex max-w-6xl flex-col gap-2 px-6 py-10 text-sm md:flex-row md:justify-between"
      >
        <p>© {new Date().getFullYear()} {siteConfig.legalName}</p>
        <ul class="flex gap-6">
          <li><a href={url('/aviso-legal')} class="hover:text-accent">Aviso legal</a></li>
          <li><a href={url('/privacidad')} class="hover:text-accent">Privacidad</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
