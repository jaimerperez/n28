---
import '../styles/global.css';
import { siteConfig, nav } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} — ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="min-h-screen bg-ink text-bone antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-ink"
    >
      Saltar al contenido
    </a>

    <header class="border-b border-white/10">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5" aria-label="Principal">
        <a href={import.meta.env.BASE_URL} class="font-display text-xl tracking-tight">
          {siteConfig.name}
        </a>
        <ul class="hidden gap-8 text-sm md:flex">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="transition-colors hover:text-accent"
                  aria-current={currentPath === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-10 text-sm text-bone/60 md:flex-row md:justify-between">
        <p>© {new Date().getFullYear()} {siteConfig.legalName}</p>
        <ul class="flex gap-6">
          <li><a href="/aviso-legal" class="hover:text-accent">Aviso legal</a></li>
          <li><a href="/privacidad" class="hover:text-accent">Privacidad</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
