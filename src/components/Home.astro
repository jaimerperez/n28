---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Logo from './Logo.astro';
import SectionNav from './SectionNav.astro';
import TornEdge from './TornEdge.astro';
import WorkCarousel from './WorkCarousel.astro';
import { siteConfig } from '../config/site';
import { homePath, languages, ui, type Lang } from '../i18n/ui';
import { url } from '../lib/url';
import hero from '../assets/hero.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const langs = Object.keys(languages) as Lang[];

// Sin backend: Web3Forms reenvía el formulario por email.
// La clave se inyecta en build desde el secreto WEB3FORMS_KEY del repositorio.
const formKey = siteConfig.contactFormKey;
const field =
  'border-bone/60 focus:border-bone w-full border-0 border-b-2 bg-transparent px-0 py-2 font-mono outline-none';
const heroButton =
  'border-bone text-bone bg-ink/30 hover:bg-bone hover:text-ink grid size-11 place-items-center rounded-full border-2 backdrop-blur-sm transition-colors md:size-12';
---

<script>
  // Vídeo de portada: se inyecta por script para que la foto se pinte primero como póster.
  const holder = document.querySelector<HTMLElement>('[data-hero-video]');
  if (holder?.dataset.heroVideo) {
    const iframe = document.createElement('iframe');
    iframe.src = holder.dataset.heroVideo;
    iframe.title = '';
    iframe.tabIndex = -1;
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.setAttribute('playsinline', '');
    // Vídeo 4:3 escalado para cubrir su caja (equivalente a object-fit: cover).
    iframe.className =
      'pointer-events-none absolute top-1/2 left-1/2 h-[max(100cqh,75cqw)] w-[max(100cqw,133.34cqh)] -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-1000';
    iframe.addEventListener('load', () => iframe.classList.remove('opacity-0'));
    holder.append(iframe);

    // Controles de play/pausa y sonido. Hablan con el reproductor por la API de mensajes de
    // Vimeo (sin cargar su librería) y el estado de los botones lo marcan los eventos que
    // devuelve el propio reproductor, por si el navegador bloquea la reproducción automática.
    const VIMEO = 'https://player.vimeo.com';
    const controls = document.querySelector<HTMLElement>('[data-hero-controls]');
    const playButton = controls?.querySelector<HTMLButtonElement>('[data-hero-play]');
    const soundButton = controls?.querySelector<HTMLButtonElement>('[data-hero-sound]');
    const post = (method: string, value?: unknown) =>
      iframe.contentWindow?.postMessage(JSON.stringify({ method, value }), VIMEO);

    let playing = false;
    let muted = true;
    const render = () => {
      if (!controls || !playButton || !soundButton) return;
      playButton.setAttribute('aria-label', controls.dataset[playing ? 'pause' : 'play'] ?? '');
      soundButton.setAttribute('aria-label', controls.dataset[muted ? 'unmute' : 'mute'] ?? '');
      playButton.querySelector('[data-icon="pause"]')?.classList.toggle('hidden', !playing);
      playButton.querySelector('[data-icon="play"]')?.classList.toggle('hidden', playing);
      soundButton.querySelector('[data-icon="muted"]')?.classList.toggle('hidden', !muted);
      soundButton.querySelector('[data-icon="sound"]')?.classList.toggle('hidden', muted);
    };

    window.addEventListener('message', (event) => {
      if (event.origin !== VIMEO || event.source !== iframe.contentWindow) return;
      let data: { event?: string };
      try {
        data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
      } catch {
        return;
      }
      if (data.event === 'ready') {
        for (const name of ['play', 'playing', 'pause', 'volumechange']) {
          post('addEventListener', name);
        }
        controls?.removeAttribute('hidden');
      } else if (data.event === 'play' || data.event === 'playing') {
        playing = true;
      } else if (data.event === 'pause') {
        playing = false;
      }
      render();
    });

    playButton?.addEventListener('click', () => {
      post(playing ? 'pause' : 'play');
      playing = !playing;
      render();
    });

    soundButton?.addEventListener('click', () => {
      muted = !muted;
      post('setMuted', muted);
      post('setVolume', muted ? 0 : 1);
      // Si estaba en pausa y se activa el sonido, se entiende que se quiere ver.
      if (!muted && !playing) {
        post('play');
        playing = true;
      }
      render();
    });

    render();
  }
</script>

<Layout lang={lang} home>
  <!-- Inicio: foto a sangre, menú arriba a la izquierda y lema abajo a la derecha -->
  <section id="inicio" class="relative overflow-hidden">
    <!--
      Caja del vídeo: en móvil ocupa el ancho de la pantalla en su proporción 4:3 (se ve
      entero); desde tablet cubre todo el hero.
    -->
    <div
      class="absolute inset-x-0 top-[45%] aspect-video -translate-y-1/2 md:inset-0 md:aspect-auto md:translate-y-0"
    >
      <Image
        src={hero}
        alt=""
        widths={[480, 830]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[50%_25%]"
      />
      <!-- Vídeo de fondo: se inyecta por script encima de la foto, que hace de póster -->
      <div
        class="[container-type:size] absolute inset-0 overflow-hidden"
        data-hero-video={`https://player.vimeo.com/video/${siteConfig.heroVideoId}?background=1&autoplay=1&muted=1&loop=1&playsinline=1&dnt=1`}
        aria-hidden="true"
      >
      </div>
    </div>
    <div class="from-ink/70 absolute inset-0 bg-linear-to-t via-transparent to-transparent"></div>
    <!-- Oscurece la parte de arriba para que el menú y el logo se lean sobre cualquier fotograma -->
    <div class="from-ink/60 absolute inset-x-0 top-0 h-48 bg-linear-to-b to-transparent"></div>

    <div
      class="relative flex min-h-svh flex-col justify-between px-5 pt-6 pb-36 md:px-10 md:pt-10 md:pb-48"
    >
      <div class="flex items-start justify-between">
        <SectionNav lang={lang} active="inicio" />
        <div class="flex items-start gap-5">
          <ul class="font-nav flex gap-2 pt-1 text-sm uppercase">
            {
              langs.map((code) => (
                <li>
                  <a
                    href={homePath(code)}
                    hreflang={code}
                    aria-current={code === lang ? 'true' : undefined}
                    class:list={[code === lang ? 'font-bold' : 'opacity-60 hover:opacity-100']}
                  >
                    {languages[code]}
                  </a>
                </li>
              ))
            }
          </ul>
          <Logo class="text-5xl md:text-7xl" />
        </div>
      </div>

      <div class="flex items-end justify-between gap-4">
        <!-- Controles del vídeo de portada: se muestran cuando el reproductor está listo -->
        <div
          class="flex gap-3"
          data-hero-controls
          data-play={t.hero.video.play}
          data-pause={t.hero.video.pause}
          data-mute={t.hero.video.mute}
          data-unmute={t.hero.video.unmute}
          hidden
        >
          <button type="button" class={heroButton} data-hero-play>
            <svg
              viewBox="0 0 24 24"
              class="size-5 fill-current"
              aria-hidden="true"
              data-icon="pause"
            >
              <path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>
            </svg>
            <svg
              viewBox="0 0 24 24"
              class="ml-0.5 hidden size-5 fill-current"
              aria-hidden="true"
              data-icon="play"
            >
              <path d="M6 4l14 8-14 8z"></path>
            </svg>
          </button>
          <button type="button" class={heroButton} data-hero-sound>
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              data-icon="muted"
            >
              <path d="M11 5L6 9H3v6h3l5 4z" fill="currentColor"></path>
              <path d="M22 9l-6 6M16 9l6 6"></path>
            </svg>
            <svg
              viewBox="0 0 24 24"
              class="hidden size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              data-icon="sound"
            >
              <path d="M11 5L6 9H3v6h3l5 4z" fill="currentColor"></path>
              <path d="M15.5 8.5a5 5 0 010 7M19 5a10 10 0 010 14"></path>
            </svg>
          </button>
        </div>

        <div class="ml-auto text-right">
          <h1 class="ml-auto max-w-[18ch] font-mono text-xl leading-snug md:text-3xl">
            {t.hero.tagline}
          </h1>
          <a
            href="#contacto"
            class="border-bone font-nav hover:bg-bone hover:text-ink mt-5 inline-block rounded-full border-2 px-7 py-2.5 text-sm font-bold uppercase transition-colors"
          >
            {t.hero.cta}
          </a>
        </div>
      </div>
    </div>

    <TornEdge seed={3} class="text-ink absolute inset-x-0 bottom-0 h-20 md:h-32" />
  </section>

  <!-- Equipo -->
  <div class="bg-ink">
    <TornEdge seed={11} class="text-bone h-14 md:h-24" />
  </div>
  <section id="equipo" class="bg-bone text-ink relative px-5 pt-8 pb-40 md:px-10 md:pb-56">
    <SectionNav lang={lang} active="equipo" repeat />

    <h2
      class="font-display mt-10 text-center text-[clamp(3.2rem,9vw,8.5rem)] leading-[0.9] uppercase md:mt-12"
    >
      {t.team.heading}
    </h2>
    <p
      class="font-nav mx-auto mt-6 max-w-4xl text-lg font-medium uppercase md:text-xl [&>span:nth-child(2)]:md:text-right"
    >
      {t.team.story.map((line) => <span class="block">{line}</span>)}
    </p>

    <ul class="border-ink/70 mx-auto mt-20 max-w-5xl font-mono text-sm md:mt-28">
      {
        siteConfig.team.map((name) => (
          <li class="border-ink/70 flex justify-between gap-4 border-b py-3">
            <span>{name}</span>
            <span class="text-right">{t.team.role} +</span>
          </li>
        ))
      }
    </ul>

    <TornEdge seed={19} class="text-ink absolute inset-x-0 bottom-0 h-20 md:h-32" />
  </section>

  <!-- Franja: trabajos seleccionados + manifiesto -->
  <section
    class="text-bone relative flex flex-col justify-between gap-10 px-5 pt-6 pb-36 md:flex-row md:px-10 md:pb-44"
  >
    <div class="font-nav text-sm uppercase">
      <p class="font-bold">{t.selected.label}</p>
      <ul class="italic opacity-80">
        {t.selected.categories.map((category) => <li>{category}</li>)}
      </ul>
    </div>
    <p
      class="font-nav max-w-xs self-end text-right text-xl leading-tight font-bold tracking-wide uppercase md:max-w-sm md:text-2xl"
    >
      {t.selected.statement}
    </p>

    <TornEdge seed={27} class="text-red absolute inset-x-0 bottom-0 h-20 md:h-32" />
  </section>

  <!-- Trabajos -->
  <section id="trabajos" class="bg-red text-bone relative overflow-hidden pt-4 pb-40 md:pb-56">
    <div class="px-5 pt-4 md:px-10">
      <div class="flex items-start justify-between">
        <SectionNav lang={lang} active="trabajos" repeat />
        <Logo class="text-4xl md:text-6xl" />
      </div>
      <h2
        class="font-display mt-8 text-center text-[clamp(4.5rem,14vw,15rem)] leading-[0.85] uppercase md:mt-4"
      >
        {t.work.title}
      </h2>
    </div>

    <div class="mt-8">
      <WorkCarousel lang={lang} />
    </div>

    <TornEdge seed={33} class="text-ink absolute inset-x-0 bottom-0 h-20 md:h-32" />
  </section>

  <!-- Historia -->
  <section class="text-bone relative px-4 pt-16 pb-40 md:pt-24 md:pb-56">
    <h2 class="font-display text-center text-[clamp(3.2rem,10vw,9.5rem)] leading-[0.9] uppercase">
      {t.story}
    </h2>
    <TornEdge seed={42} class="text-blue absolute inset-x-0 bottom-0 h-24 md:h-40" />
  </section>

  <!-- Contacto -->
  <section id="contacto" class="bg-blue text-bone px-5 pt-16 pb-10 md:px-10 md:pt-24">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-sm uppercase md:text-base">{t.contact.label}:</p>
      <a
        href={`mailto:${siteConfig.email}`}
        class="font-nav mt-1 block text-4xl font-bold break-all uppercase hover:underline md:text-7xl"
      >
        {siteConfig.email}
      </a>

      <div class="mt-20 flex flex-col justify-between gap-10 sm:flex-row md:mt-28">
        <div>
          <p class="font-nav text-4xl font-bold uppercase md:text-5xl">{siteConfig.city}</p>
          <p class="ml-8 font-mono text-sm uppercase">{t.contact.cityNote}</p>
        </div>
        <div class="sm:text-right">
          <p class="font-nav text-4xl font-bold uppercase md:text-5xl">{t.contact.follow}</p>
          <a
            href={siteConfig.social.instagram.href}
            rel="noopener"
            class="inline-flex items-center gap-2 font-mono text-sm hover:underline"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
            </svg>
            Instagram {siteConfig.social.instagram.label}
          </a>
        </div>
      </div>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="border-bone/30 mt-24 space-y-8 border-t pt-12"
      >
        <h3 class="font-display text-4xl uppercase md:text-6xl">{t.contact.formTitle}</h3>
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="subject" value="Nueva solicitud desde la web de N28 Project" />
        <input type="hidden" name="redirect" value={new URL(url('/gracias'), Astro.site).href} />
        <!-- Trampa antispam: los bots la rellenan, las personas no la ven -->
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" />

        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <label for="nombre" class="font-nav block text-sm uppercase">{t.contact.name}</label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              class={field}
            />
          </div>
          <div>
            <label for="email" class="font-nav block text-sm uppercase">{t.contact.email}</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class={field}
            />
          </div>
        </div>

        <div>
          <label for="mensaje" class="font-nav block text-sm uppercase">{t.contact.message}</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class={field}></textarea>
        </div>

        <div class="flex gap-3">
          <input
            id="privacidad"
            name="privacidad"
            type="checkbox"
            required
            class="accent-bone mt-1"
          />
          <label for="privacidad" class="text-sm">
            {t.contact.privacyPrefix}{' '}
            <a href={url('/privacidad')} class="underline underline-offset-2">
              {t.contact.privacyLink}
            </a>.
          </label>
        </div>

        <button
          type="submit"
          class="bg-bone text-blue font-nav rounded-full px-8 py-3 font-bold uppercase transition-opacity hover:opacity-90"
        >
          {t.contact.submit}
        </button>
      </form>

      <footer
        class="border-bone/30 mt-20 flex flex-col gap-3 border-t pt-6 text-sm md:flex-row md:items-center md:justify-between"
      >
        <p>© {new Date().getFullYear()} {siteConfig.legalName}</p>
        <ul class="flex gap-6">
          <li><a href={url('/precios')} class="hover:underline">{t.footer.prices}</a></li>
          <li><a href={url('/aviso-legal')} class="hover:underline">{t.footer.notice}</a></li>
          <li><a href={url('/privacidad')} class="hover:underline">{t.footer.privacy}</a></li>
        </ul>
      </footer>
    </div>
  </section>

  <!-- Volver arriba: aparece cuando la portada sale de la pantalla -->
  <a
    href="#inicio"
    class="border-bone bg-ink text-bone hover:bg-bone hover:text-ink pointer-events-none fixed right-4 bottom-4 z-40 grid size-12 translate-y-4 place-items-center rounded-full border-2 opacity-0 transition md:right-8 md:bottom-8 md:size-14"
    aria-label={t.toTop}
    tabindex="-1"
    data-to-top
  >
    <svg
      viewBox="0 0 24 24"
      class="size-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
  </a>
</Layout>

<script>
  const toTop = document.querySelector<HTMLElement>('[data-to-top]');
  const hero = document.getElementById('inicio');
  if (toTop && hero) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      toTop.classList.toggle('opacity-0', !show);
      toTop.classList.toggle('translate-y-4', !show);
      toTop.classList.toggle('pointer-events-none', !show);
      toTop.tabIndex = show ? 0 : -1;
    }).observe(hero);
  }
</script>
