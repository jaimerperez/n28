---
import { Image } from 'astro:assets';
import { works, embedUrl } from '../content/works';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].work;

// Carrusel circular: los trabajos se pintan tres veces y se navega siempre por la copia
// central. Al acercarse a un extremo el script salta, sin animación, a la posición
// equivalente del centro, así nunca hay huecos a los lados. Las copias son `inert`.
const COPIES = 3;
const slides = Array.from({ length: COPIES }, (_, copy) =>
  works.map((work) => ({ work, clone: copy !== 1 })),
).flat();
---

<div class="relative" data-carousel>
  <ul
    class="no-scrollbar relative flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth"
    data-track
    data-copies={COPIES}
  >
    {
      slides.map(({ work, clone }) => {
        const src = embedUrl(work.video);
        return (
          <li
            class="w-[76vw] shrink-0 snap-center md:w-[60vw]"
            data-slide
            inert={clone}
            aria-hidden={clone ? 'true' : undefined}
          >
            <div
              class="bg-ink relative aspect-video overflow-hidden rounded-2xl"
              data-player={src ?? undefined}
              data-title={work.title}
            >
              {work.poster && (
                <Image
                  src={work.poster}
                  alt=""
                  widths={[480, 800, 1280]}
                  sizes="(min-width: 768px) 60vw, 76vw"
                  class:list={[
                    'absolute inset-0 h-full w-full',
                    work.posterFit === 'contain' ? 'object-contain' : 'object-cover',
                  ]}
                />
              )}
              {src ? (
                <button
                  type="button"
                  class="group absolute inset-0 grid place-items-center"
                  aria-label={`${t.play}: ${work.title}`}
                  data-play
                >
                  <span class="border-bone/90 bg-ink/30 grid size-16 place-items-center rounded-full border-2 backdrop-blur-sm transition-transform group-hover:scale-110 md:size-20">
                    <svg viewBox="0 0 24 24" class="fill-bone ml-1 size-7" aria-hidden="true">
                      <path d="M6 4l14 8-14 8z" />
                    </svg>
                  </span>
                </button>
              ) : (
                <span class="bg-ink/70 font-nav absolute bottom-4 left-4 rounded-full px-3 py-1 text-sm uppercase">
                  {t.soon}
                </span>
              )}
            </div>
            <h3 class="font-display mt-4 text-3xl uppercase md:text-5xl">{work.title}</h3>
            <p class="font-mono text-xs uppercase opacity-70">{work.category[lang]}</p>
          </li>
        );
      })
    }
  </ul>

  <button
    type="button"
    class="border-bone text-bone bg-ink/30 absolute top-[calc(50%-3rem)] left-2 grid size-11 place-items-center rounded-full border-2 text-xl font-bold backdrop-blur-sm md:left-8 md:size-14"
    aria-label={t.prev}
    data-step="-1">«</button
  >
  <button
    type="button"
    class="border-bone text-bone bg-ink/30 absolute top-[calc(50%-3rem)] right-2 grid size-11 place-items-center rounded-full border-2 text-xl font-bold backdrop-blur-sm md:right-8 md:size-14"
    aria-label={t.next}
    data-step="1">»</button
  >
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) continue;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const count = slides.length / Number(track.dataset.copies);

    // Posición de scroll que deja centrada la diapositiva `i`.
    const centerOf = (i: number) =>
      slides[i].offsetLeft + slides[i].offsetWidth / 2 - track.clientWidth / 2;

    const nearest = () => {
      const middle = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - middle);
        const bestDistance = Math.abs(
          slides[best].offsetLeft + slides[best].offsetWidth / 2 - middle,
        );
        if (distance < bestDistance) best = i;
      });
      return best;
    };

    const jumpTo = (left: number) => {
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = left;
      track.style.scrollBehavior = '';
    };

    // Si la diapositiva centrada es una copia, salta a su original de la copia central.
    const recenter = () => {
      const i = nearest();
      const original = count + (i % count);
      if (i !== original) jumpTo(centerOf(original) + (track.scrollLeft - centerOf(i)));
    };

    jumpTo(centerOf(count));

    if ('onscrollend' in window) {
      track.addEventListener('scrollend', recenter);
    } else {
      let timer: number | undefined;
      track.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = window.setTimeout(recenter, 150);
      });
    }

    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      jumpTo(centerOf(count + (nearest() % count)));
    });

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      button.addEventListener('click', () => {
        // Recentrar antes de moverse: aunque `scrollend` no llegue, nunca se alcanza un extremo.
        recenter();
        const target = nearest() + Number(button.dataset.step);
        track.scrollTo({ left: centerOf(target) });
      });
    }
  }

  // Fachada: el iframe del reproductor solo se crea al pulsar "reproducir".
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-play]')) {
    button.addEventListener('click', () => {
      const player = button.closest<HTMLElement>('[data-player]');
      if (!player?.dataset.player) return;
      const iframe = document.createElement('iframe');
      iframe.src = player.dataset.player;
      iframe.title = player.dataset.title ?? '';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      player.replaceChildren(iframe);
    });
  }
</script>
